# ─────────────────────────────────────────────────────────────
# Reels Intelligence — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────

# ── Apify ──────────────────────────────────────────────────────
# Get from: apify.com → Settings → Integrations → API Tokens
APIFY_API_KEY=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Apify actor to use (do not change unless switching actors)
APIFY_ACTOR_ID=apify~instagram-reel-scraper

# Apify actor for YouTube channel scraping (cloud-safe — no IP block issues)
APIFY_YT_ACTOR_ID=streamers~youtube-scraper

# Apify actor for IG hashtag discovery (used by trending pipeline)
APIFY_IG_HASHTAG_ACTOR_ID=apify~instagram-hashtag-scraper

# Apify actor for TikTok video scraping (used by trending pipeline)
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper

# Polling: how often to check if the Apify run finished (ms)
APIFY_POLL_INTERVAL_MS=5000

# Timeout: max time to wait for Apify run before giving up (ms)
APIFY_TIMEOUT_MS=180000

# ── Anthropic ───────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model to use for analysis
CLAUDE_MODEL=claude-opus-4-5

# How many reels to send Claude in one batch (keep ≤ 15)
CLAUDE_BATCH_SIZE=10

# ── Airtable ────────────────────────────────────────────────────
# Get API key from: airtable.com/create/tokens → create a token with
# scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get Base ID from your Airtable base URL:
# airtable.com/appXXXXXXXXXXXXXX/...
#              ^^^^^^^^^^^^^^^^^ this part
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxxxxxxx

# Table names — must match exactly what you created in Airtable (case-sensitive)
AIRTABLE_REELS_TABLE=Reels
AIRTABLE_CREATORS_TABLE=Creators
AIRTABLE_RUNS_TABLE=Runs
AIRTABLE_ANALYSES_TABLE=Analyses
AIRTABLE_CREATOR_ANALYSIS_TABLE=Creator Analysis
AIRTABLE_CUMULATIVE_ANALYSIS_TABLE=Cumulative Analysis
AIRTABLE_YT_VIDEOS_TABLE=YouTube Videos
AIRTABLE_YT_SHORTS_TABLE=YouTube Shorts
AIRTABLE_YT_LONGFORM_TABLE=YouTube Long-form
AIRTABLE_YT_CREATORS_TABLE=YouTube Creators
AIRTABLE_YT_RUNS_TABLE=YouTube Runs
AIRTABLE_CONTENT_IDEAS_TABLE=Content Ideas
AIRTABLE_CONTENT_CALENDAR_TABLE=Content Calendar
AIRTABLE_TRENDING_SOURCES_TABLE=Trending Sources
AIRTABLE_IG_TRENDING_TABLE=IG Trending
AIRTABLE_YT_SHORTS_TRENDING_TABLE=YT Shorts Trending
AIRTABLE_YT_LONGFORM_TRENDING_TABLE=YT Long-form Trending
AIRTABLE_TIKTOK_TRENDING_TABLE=TikTok Trending

# ── Brand DNA (cross-base, multi-tenant) ────────────────────────
# Brand DNA lives in a SEPARATE per-client Airtable base. See the
# Clients table in Brand OS Master for the Brand DNA Base ID per
# client. This pipeline READS from that base — it does NOT own DNA.
# Defaults below point at Abundance.AI's base as a placeholder.
BRAND_DNA_BASE_ID=appKg5KqW82kOucCL
BRAND_DNA_PROFILE_TABLE_ID=tbl1tkPkABIqyJjrF
BRAND_DNA_VOICE_TABLE_ID=tbl7ZSgUKZFpiI2I6
BRAND_DNA_ICPS_TABLE_ID=tblioaRLaLEQSwQ1x

# ── Scraping ────────────────────────────────────────────────────
# Default reel limit per creator per run (overridden per-creator in targets.json)
REELS_PER_CREATOR=20

# ── Scheduling ──────────────────────────────────────────────────
# Cron format: minute hour day month weekday
# Default: 8:00am UTC on the 1st and 15th of each month (bi-weekly)
# To change: update this value AND redeploy via Trigger.dev
# Examples:
#   weekly (every Monday):      0 8 * * 1
#   bi-weekly (1st and 15th):   0 8 1,15 * *
#   daily:                      0 8 * * *
CRON_SCHEDULE=0 8 1,15 * *
YOUTUBE_CRON_SCHEDULE=0 9 1,15 * *
TRENDING_CRON_SCHEDULE=0 7 * * *

# Watchers — minimum hours between auto re-scrapes
WATCH_MIN_HOURS_BETWEEN_SCRAPES=23

# YouTube duration cutoff (seconds) for Shorts vs Long-form routing
YT_SHORTS_DURATION_MAX_S=180

# ── Trigger.dev ─────────────────────────────────────────────────
# Get from: trigger.dev → your project → Settings → Project ID
TRIGGER_PROJECT_ID=proj_xxxxxxxxxxxx

# Project Secret Key — runtime SDK auth. cloud.trigger.dev → project → API Keys
# Use tr_dev_* locally. tr_prod_* lives in the dashboard env, NOT in this file.
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx

# Personal Access Token — CLI / management API auth (optional locally).
# Get from: cloud.trigger.dev → account avatar → Personal Access Tokens
TRIGGER_ACCESS_TOKEN=tr_pat_xxxxxxxxxxxxxxxxxxxx

# ── Transcription (optional — for reels without auto-captions) ──
# AssemblyAI: assemblyai.com → API Keys
# ASSEMBLYAI_API_KEY=
# OpenAI Whisper (alternative): platform.openai.com → API Keys
# OPENAI_API_KEY=

# ── Debug ───────────────────────────────────────────────────────
# Set to true to get full error stack traces in research-agent.js
DEBUG=false
