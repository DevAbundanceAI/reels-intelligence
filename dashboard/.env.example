# Copy to .env and fill in real values. Never commit .env.
#
# All three keys are required. The dashboard renders nothing useful
# without them, but auth/middleware will still let pages load.

# Trigger.dev project secret key.
#   cloud.trigger.dev → project → API Keys.
# tr_prod_* gets you the production runs. tr_dev_* shows the dev env.
# Read-only API access is fine; the dashboard never triggers tasks.
TRIGGER_SECRET_KEY=

# Airtable PAT, read-only is enough.
#   airtable.com/create/tokens
# Scopes: data.records:read on the Reels Intelligence base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appYfkPFW0Meaj7aG

# Optional basic auth. Set both to gate the dashboard. Leave both
# unset for open access (local dev only — never deploy public).
OPS_BASIC_AUTH_USER=
OPS_BASIC_AUTH_PASS=
