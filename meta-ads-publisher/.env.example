# Google - service account key with drive.readonly scope.
# Share each brand's Drive root folder with this service account's email as Viewer.
GOOGLE_SERVICE_ACCOUNT_KEY=/absolute/path/to/service-account.key.json
# Fallback if you have no service account (short-lived):
# GOOGLE_OAUTH_TOKEN=

# Meta - long-lived System User token(s) with ads_management + business_management.
# One per Business Portfolio; the brand config's token_env picks which one is used.
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_EH=
